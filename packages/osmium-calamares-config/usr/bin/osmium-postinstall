#!/usr/bin/env bash
# Runs inside the installed system's chroot (Calamares shellprocess@postinstall).
set -euo pipefail

# Live-ISO leftovers copied from the squashfs.
rm -f /etc/sysusers.d/osmium.conf /etc/sudoers.d/osmium /etc/motd \
      /etc/mkinitcpio.conf.d/archiso.conf /etc/ssh/sshd_config.d/10-archiso.conf \
      /etc/systemd/journald.conf.d/volatile-storage.conf /etc/systemd/logind.conf.d/do-not-suspend.conf \
      /etc/systemd/resolved.conf.d/archiso.conf /etc/systemd/system-generators/systemd-gpt-auto-generator \
      /etc/systemd/network/20-{ethernet,wlan,wwan}.network \
      /etc/systemd/system/{choose-mirror,livecd-alsa-unmuter,livecd-talk,pacman-init}.service \
      /etc/systemd/system/etc-pacman.d-gnupg.mount \
      /usr/local/bin/{Installation_guide,choose-mirror,livecd-sound} \
      /usr/share/applications/osmium-install.desktop
rm -rf /etc/systemd/system/getty@tty1.service.d /etc/systemd/system/cloud-init.target.wants \
       /etc/systemd/system/systemd-networkd-wait-online.service.d /usr/local/share/livecd-sound \
       /root/.automated_script.sh /root/.zlogin /home/osmium
# Units removed above leave dangling enable symlinks.
find /etc/systemd/system -xtype l -delete

# The live root has an empty password: lock it, admin goes through sudo (wheel).
passwd -l root

# The live keyring lived on tmpfs; the installed system needs its own.
pacman-key --init
pacman-key --populate archlinux

grep -q '^\[osmium\]' /etc/pacman.conf || cat >> /etc/pacman.conf <<'CONF'

[osmium]
# shortcut: unsigned repo over HTTPS; add a signing key before public release.
SigLevel = Optional TrustAll
Server = https://github.com/EtliBiftek/osmium-os/releases/download/repo
CONF

# Kernel image for initcpio and the bootloader (the live ISO keeps it outside the squashfs).
install -Dm644 "$(ls /usr/lib/modules/*/vmlinuz | head -n1)" /boot/vmlinuz-linux

install -Dm644 /usr/share/osmium/greetd.toml /etc/greetd/config.toml

# Snapshots only make sense on btrfs root.
if btrfs subvolume show / &>/dev/null; then
  snapper --no-dbus -c root create-config /
fi
