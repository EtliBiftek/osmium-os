# Maintainer: EtliBiftek
pkgname=osmium-calamares-config
pkgver=0.1.0
pkgrel=1
pkgdesc="OsmiumOS installer: Calamares config, branding, Btrfs + snapper setup"
arch=('any')
url="https://github.com/EtliBiftek/osmium-os"
license=('MIT' 'GPL-3.0-or-later')  # branding/ images and show.qml come from Calamares
depends=(
  osmium-tools calamares python rsync
  btrfs-progs snapper snap-pac grub grub-btrfs inotify-tools efibootmgr os-prober
  networkmanager
)

package() {
  install -Dm644 "${OSMIUM_SRC:?build with osmium-build}/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
  cp -rT "$startdir/etc" "$pkgdir/etc"
}
