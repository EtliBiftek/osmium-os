{
  "layer": "top",
  "height": 32,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray", "custom/notification"],
  "clock": { "format": "{:%H:%M  %d.%m.%Y}" },
  "pulseaudio": { "format": "  {volume}%", "format-muted": "  sessiz", "on-click": "pavucontrol" },
  "network": { "format-wifi": "  {essid}", "format-ethernet": "󰈀  bağlı", "format-disconnected": "󰖪  yok" },
  "battery": { "format": "{icon}  {capacity}%", "format-icons": ["", "", "", "", ""] },
  "tray": { "spacing": 8 },
  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "",
    "on-click": "swaync-client -t -sw"
  }
}
