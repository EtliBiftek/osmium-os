# Maintainer: EtliBiftek
pkgname=osmium-hyprland
pkgver=0.1.0
pkgrel=1
pkgdesc="OsmiumOS ready-to-use Hyprland desktop (configs, theme, apps)"
arch=('any')
url="https://github.com/EtliBiftek/osmium-os"
license=('MIT')
depends=(
  hyprland hypridle hyprlock hyprpolkitagent xdg-desktop-portal-hyprland
  ironbar swaync anyrun alacritty cosmic-files swayosd
  osmium-tools power-profiles-daemon libnotify
  grim slurp wl-clipboard
  pipewire pipewire-pulse wireplumber
  qt5-wayland qt6-wayland polkit
  greetd greetd-tuigreet
  ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji papirus-icon-theme
)

package() {
  install -Dm644 "${OSMIUM_SRC:?build with osmium-build}/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -d "$pkgdir/etc/skel"
  cp -rT "$startdir/skel" "$pkgdir/etc/skel"
  install -Dm644 "$startdir/usr/share/osmium/greetd.toml" -t "$pkgdir/usr/share/osmium/"
}
