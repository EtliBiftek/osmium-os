# Maintainer: EtliBiftek
pkgname=osmium-gnome
pkgver=0.1.0
pkgrel=1
pkgdesc="OsmiumOS ready-to-use GNOME desktop (defaults, apps)"
arch=('any')
url="https://github.com/EtliBiftek/osmium-os"
license=('MIT')
depends=(
  gnome-shell gdm gnome-control-center gnome-console nautilus gnome-text-editor
  loupe papers gnome-system-monitor gnome-tweaks xdg-desktop-portal-gnome gnome-keyring
  networkmanager pipewire pipewire-pulse wireplumber noto-fonts noto-fonts-emoji
  osmium-tools power-profiles-daemon libnotify
)
install=osmium-gnome.install

package() {
  install -Dm644 "${OSMIUM_SRC:?build with osmium-build}/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
  cp -rT "$startdir/etc" "$pkgdir/etc"
}
