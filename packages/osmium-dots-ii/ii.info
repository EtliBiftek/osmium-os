# ii builds its whole Material palette from an accent color or a wallpaper (matugen).
renk.uygula=$HOME/.config/quickshell/ii/scripts/colors/switchwall.sh --color {renk}
duvar.uygula=$HOME/.config/quickshell/ii/scripts/colors/switchwall.sh --image {duvar}
# Super+L locks (loginctl lock-session); a mixed-in lock screen takes that key.
kilit.tus=SUPER, L
