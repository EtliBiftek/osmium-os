# Maintainer: EtliBiftek
# Built from this repo's tools/ crate; osmium-build sets OSMIUM_SRC to the repo root.
pkgname=osmium-tools
pkgver=0.5.0
pkgrel=1
pkgdesc="OsmiumOS system tools (Rust): modes, config history, update risk check, theme sharing, Windows migration, local AI assistant, installer helper"
arch=('x86_64')
url="https://github.com/EtliBiftek/osmium-os"
license=('MIT')
depends=('glibc' 'gcc-libs' 'git' 'curl' 'pacman-contrib' 'sudo' 'util-linux' 'ntfs-3g' 'xdg-user-dirs' 'fontconfig')
optdepends=(
  'hyprland: osmium-mode'
  'anyrun: osmium-mode menu'
  'swaync: osmium-mode notifications'
  'power-profiles-daemon: osmium-mode power profiles'
  'libnotify: osmium-update desktop notifications'
  'github-cli: osmium-share publish'
  'ollama: osmium-ai local model backend'
  'networkmanager: osmium-migrate wifi'
)
makedepends=('cargo')

build() {
  cargo build --release --locked \
    --manifest-path "${OSMIUM_SRC:?build with osmium-build}/tools/Cargo.toml" \
    --target-dir "$srcdir/target"
}

package() {
  install -Dm644 "${OSMIUM_SRC:?build with osmium-build}/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
  local data="$OSMIUM_SRC/tools/data"
  install -Dm755 "$srcdir"/target/release/osmium-{postinstall,mode,history,update,share,ai,migrate,welcome} -t "$pkgdir/usr/bin/"
  install -Dm644 "$data"/modes/*.mode -t "$pkgdir/usr/share/osmium/modes/"
  install -Dm644 "$data"/ai.conf -t "$pkgdir/usr/share/osmium/"
  install -Dm644 "$data"/systemd/*.{service,timer} -t "$pkgdir/usr/lib/systemd/user/"
  # Enabled for every user by default; `systemctl --user disable <name>.timer` opts out.
  install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
  local t
  for t in osmium-history osmium-update; do
    ln -s ../$t.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/$t.timer"
  done
}
