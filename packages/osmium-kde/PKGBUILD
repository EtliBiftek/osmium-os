# Maintainer: EtliBiftek
pkgname=osmium-kde
pkgver=0.1.0
pkgrel=1
pkgdesc="OsmiumOS ready-to-use KDE Plasma desktop (defaults, apps)"
arch=('any')
url="https://github.com/EtliBiftek/osmium-os"
license=('GPL-3.0-or-later')
depends=(
  plasma-desktop sddm sddm-kcm konsole dolphin kate ark spectacle gwenview okular
  plasma-nm plasma-pa powerdevil kscreen bluedevil breeze-gtk kde-gtk-config
  xdg-desktop-portal-kde pipewire pipewire-pulse wireplumber
  noto-fonts noto-fonts-emoji alacritty
  osmium-tools power-profiles-daemon libnotify networkmanager
)

package() {
  install -Dm644 "${OSMIUM_SRC:?build with osmium-build}/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -d "$pkgdir/etc/skel"
  cp -rT "$startdir/skel" "$pkgdir/etc/skel"
}
