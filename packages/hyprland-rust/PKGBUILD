# Maintainer: EtliBiftek
# The user's own Rust/Smithay reimplementation of Hyprland. _commit and sha256sums are
# bumped by .github/workflows/hyprland-rust-bump.yml once that commit's CI is green.
pkgname=hyprland-rust
_commit=c99e53352de1e5ea7ffc02b9f1a196259a0ea169
pkgver=0.1.0.r${_commit:0:7}
pkgrel=1
pkgdesc="Hyprland-compatible dynamic tiling Wayland compositor written in Rust"
arch=('x86_64')
url="https://github.com/EtliBiftek/hyprland-rust"
license=('BSD-3-Clause' 'MIT')
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'libinput' 'seatd' 'systemd-libs' 'libdrm' 'mesa' 'libglvnd')
makedepends=('cargo')
# makepkg's -flto turns vendored Lua (mlua) into GCC LTO objects that ld.lld cannot link.
options=('!lto')
provides=('hyprctl')
# Both ship /usr/bin/hyprctl.
conflicts=('hyprland')
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('63b67415405113ff81576e8644d128dbfeacb3c4ba83f8f267805a70c0d6044a')

build() {
  cd "$pkgname-$_commit"
  cargo build --release --locked --target-dir "$srcdir/target"
}

package() {
  cd "$pkgname-$_commit"
  install -Dm755 "$srcdir"/target/release/{hyprland-rust,hyprctl} -t "$pkgdir/usr/bin/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 docs/SMITHAY-LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 examples/hyprland.lua -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/wayland-sessions/hyprland-rust.desktop" <<DESKTOP
[Desktop Entry]
Name=Hyprland (Rust)
Comment=OsmiumOS tiling compositor
Exec=hyprland-rust --backend tty
Type=Application
DesktopNames=Hyprland
DESKTOP
}
